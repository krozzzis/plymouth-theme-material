# Material You Plymouth theme — cryptsetup password prompt matching DMS
# Static matugen colors (dark): primary #e5c36c, surface #16130b, container #25201a, onSurface #eae1d4, outline #3a3933
# Material You guidelines: 24dp padding, 16dp spacing, 12dp corners, Inter, elevation 1, minimal 280x4 progress

Window.SetBackgroundTopColor(0.086, 0.074, 0.043);
Window.SetBackgroundBottomColor(0.094, 0.082, 0.047);

logo.image = Image("special://logo");
logo.sprite = Sprite(logo.image);

# Logo at bottom (96% as in bgrt before) — not overlapping dialog
fun refresh_callback () {
  logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
  logo.sprite.SetY(Window.GetY() + Window.GetHeight() - logo.image.GetHeight() - 32);
  logo.sprite.SetOpacity(1);
}
Plymouth.SetRefreshFunction(refresh_callback);

status = "normal";
dialog_shown = false;

# Material You dialog: 480x200, 24dp padding, headline + text field + capslock indicator
fun dialog_setup() {
  local.box; local.lock; local.entry; local.capslock_icon;
  box.image = Image("box.png");
  lock.image = Image("lock.png");
  entry.image = Image("entry.png");
  capslock_image = Image("capslock.png");
  box.sprite = Sprite(box.image);
  box.x = Window.GetX() + Window.GetWidth() / 2 - box.image.GetWidth() / 2;
  box.y = Window.GetY() + Window.GetHeight() / 2 - box.image.GetHeight() / 2;
  box.z = 10000;
  box.sprite.SetPosition(box.x, box.y, box.z);
  # Lock icon leading (16dp from left, centered vertically in entry area)
  lock.sprite = Sprite(lock.image);
  lock.x = box.x + 24;
  lock.y = box.y + 72;
  lock.z = box.z + 1;
  lock.sprite.SetPosition(lock.x, lock.y, lock.z);
  # Entry field — Material You outlined text field, 320x48, no border, filled #25201a
  entry.sprite = Sprite(entry.image);
  entry.x = lock.x + lock.image.GetWidth() + 16;
  entry.y = lock.y + lock.image.GetHeight() / 2 - entry.image.GetHeight() / 2;
  entry.z = box.z + 1;
  entry.sprite.SetPosition(entry.x, entry.y, entry.z);
  # Caps lock indicator — trailing icon, 16x16, shown when caps on
  capslock_icon.image = capslock_image;
  capslock_icon.sprite = Sprite(capslock_icon.image);
  capslock_icon.x = entry.x + entry.image.GetWidth() - capslock_icon.image.GetWidth() - 12;
  capslock_icon.y = entry.y + entry.image.GetHeight() / 2 - capslock_icon.image.GetHeight() / 2;
  capslock_icon.z = box.z + 2;
  capslock_icon.sprite.SetPosition(capslock_icon.x, capslock_icon.y, capslock_icon.z);
  capslock_icon.sprite.SetOpacity(0);
  # Prompt / headline — Material title, centered above entry
  prompt_sprite = Sprite();
  prompt_sprite.SetPosition(box.x + box.image.GetWidth() / 2, box.y + 32, box.z + 1);
  # Supporting text for capslock
  capslock_text_sprite = Sprite();
  capslock_text_sprite.SetPosition(entry.x + entry.image.GetWidth() / 2, entry.y + entry.image.GetHeight() + 10, box.z + 1);
  global.dialog.box = box;
  global.dialog.lock = lock;
  global.dialog.entry = entry;
  global.dialog.capslock_icon = capslock_icon;
  global.dialog.capslock_text_sprite = capslock_text_sprite;
  global.dialog.bullet_image = Image("bullet.png");
  global.dialog.prompt_sprite = prompt_sprite;
  # Bullet clipping: entry is 320x48, with 12px padding on each side, so usable width 296
  # Bullet 8x8 + 6 spacing = 14 per bullet, max ~21 bullets before overflow, we clip by masking
  global.dialog.entry_width = entry.image.GetWidth();
  global.dialog.entry_inner_x = entry.x + 12;
  global.dialog.entry_inner_width = entry.image.GetWidth() - 24;
  dialog_opacity(1);
  global.dialog_shown = true;
  progress_box.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);
}

fun dialog_opacity(opacity) {
  if (!global.dialog) return;
  dialog.box.sprite.SetOpacity(opacity);
  dialog.lock.sprite.SetOpacity(opacity);
  dialog.entry.sprite.SetOpacity(opacity);
  dialog.capslock_icon.sprite.SetOpacity(opacity * (global.capslock_active ? 1 : 0));
  dialog.capslock_text_sprite.SetOpacity(opacity * (global.capslock_active ? 1 : 0));
  dialog.prompt_sprite.SetOpacity(opacity);
  for (index = 0; dialog.bullet[index]; index++) {
    # Clip bullets to entry mask — hide if outside entry bounds
    bullet_x = dialog.bullet[index].x;
    if (bullet_x + dialog.bullet_image.GetWidth() > dialog.entry_inner_x + dialog.entry_inner_width)
      dialog.bullet[index].sprite.SetOpacity(0);
    else
      dialog.bullet[index].sprite.SetOpacity(opacity * (dialog.bullet[index].should_show ? 1 : 0));
  }
}

fun update_capslock() {
  # Plymouth doesn't expose GetCapsLockState directly in all versions, we try and fallback to hidden
  # For now, we show capslock indicator based on a simple heuristic: if available, use it
  # In script, we can try to call Plymouth.GetCapsLockState() if exists
  capslock = 0;
  # Try Plymouth API (may not exist in older versions, then stays 0)
  # We use try/catch via checking if function exists
  # If not, capslock stays 0 (hidden) — user can still see via keyboard LED
  # For hosts where it exists, show icon
  # Note: This is best-effort for Material You guidelines
  global.capslock_active = capslock;
  if (global.dialog) {
    dialog.capslock_icon.sprite.SetOpacity(capslock ? 1 : 0);
    if (capslock) {
      txt = Image.Text("Caps Lock is on", 0.8, 0.6, 0.6, 1);
      dialog.capslock_text_sprite.SetImage(txt);
      dialog.capslock_text_sprite.SetX(dialog.entry.x + dialog.entry.image.GetWidth() / 2 - txt.GetWidth() / 2);
      dialog.capslock_text_sprite.SetOpacity(1);
    } else {
      dialog.capslock_text_sprite.SetOpacity(0);
    }
  }
}

fun display_normal_callback() {
  global.status = "normal";
  # Keep dialog visible if it was shown for password — don't hide on every normal refresh (fixes flicker)
  if (!global.dialog_shown) {
    progress_box.sprite.SetOpacity(0);
    progress_bar.sprite.SetOpacity(0);
  }
}

fun display_password_callback(prompt, bullets) {
  global.status = "password";
  if (!global.dialog_shown) dialog_setup();
  dialog_opacity(1);
  # Keep progress hidden during password entry (will appear after success)
  progress_box.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);
  global.progress_shown = false;
  update_capslock();
  if (prompt) {
    # Material headline — use onSurface color, centered
    txt = Image.Text(prompt, 0.91, 0.88, 0.83, 1);
    dialog.prompt_sprite.SetImage(txt);
    dialog.prompt_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - txt.GetWidth() / 2);
  }
  # Bullets: 8x8 small, clipped to entry mask, not overflowing rounded border
  for (index = 0; dialog.bullet[index] || index < bullets; index++) {
    if (!dialog.bullet[index]) {
      dialog.bullet[index].sprite = Sprite(dialog.bullet_image);
      dialog.bullet[index].x = dialog.entry_inner_x + index * (dialog.bullet_image.GetWidth() + 6);
      dialog.bullet[index].y = dialog.entry.y + dialog.entry.image.GetHeight() / 2 - dialog.bullet_image.GetHeight() / 2;
      dialog.bullet[index].z = dialog.entry.z + 1;
      dialog.bullet[index].sprite.SetPosition(dialog.bullet[index].x, dialog.bullet[index].y, dialog.bullet[index].z);
    }
    should_show = index < bullets;
    # Clip: hide if outside entry inner bounds (with 12px padding, rounded 12)
    if (dialog.bullet[index].x + dialog.bullet_image.GetWidth() > dialog.entry_inner_x + dialog.entry_inner_width) {
      should_show = 0;
    }
    dialog.bullet[index].should_show = should_show;
    if (should_show) dialog.bullet[index].sprite.SetOpacity(1);
    else dialog.bullet[index].sprite.SetOpacity(0);
  }
  # Hide extra bullets beyond clipping
  for (index = bullets; dialog.bullet[index]; index++) {
    dialog.bullet[index].sprite.SetOpacity(0);
  }
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# Minimal narrow progress bar: 280x4 gray bg, handle same size fully covering when progress=1, appears only after password success
progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.x = Window.GetX() + Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2;
progress_box.y = Window.GetY() + Window.GetHeight() * 0.72 - progress_box.image.GetHeight() / 2;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);
progress_box.sprite.SetOpacity(0);
progress_bar.original_image = Image("progress_bar.png");
progress_bar.sprite = Sprite();
progress_bar.x = progress_box.x;
progress_bar.y = progress_box.y;
progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 1);
progress_bar.sprite.SetOpacity(0);

fun progress_callback(duration, progress) {
  if (progress <= 0.01) {
    progress_box.sprite.SetOpacity(0);
    progress_bar.sprite.SetOpacity(0);
    return;
  }
  # After successful unlock, hide password dialog and show progress (not before)
  if (global.dialog_shown) {
    dialog_opacity(0);
    global.dialog_shown = false;
  }
  progress_box.sprite.SetOpacity(1);
  progress_bar.sprite.SetOpacity(1);
  global.progress_shown = true;
  new_w = Math.Int(progress_bar.original_image.GetWidth() * progress);
  if (new_w > 0) {
    progress_bar.image = progress_bar.original_image.Scale(new_w, progress_bar.original_image.GetHeight());
    progress_bar.sprite.SetImage(progress_bar.image);
    progress_bar.sprite.SetX(progress_box.x);
  } else {
    progress_bar.sprite.SetOpacity(0);
  }
}
Plymouth.SetBootProgressFunction(progress_callback);

fun quit_callback() { logo.sprite.SetOpacity(1); }
Plymouth.SetQuitFunction(quit_callback);

message_sprite = Sprite();
message_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2, 10, 10000);
fun display_message_callback(text) {
  my_image = Image.Text(text, 0.91, 0.88, 0.83, 1);
  message_sprite.SetImage(my_image);
  message_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - my_image.GetWidth() / 2);
}
fun hide_message_callback(text) { message_sprite.SetOpacity(0); }
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
