# Graphite and sage: a shared center axis and an 8px spacing grid.
Window.SetBackgroundTopColor(@background@);
Window.SetBackgroundBottomColor(@background@);

password_active = 0;
bullet_count = 0;

logo.image = Image("@logo@");
if (logo.image.GetWidth() > @logoSize@ || logo.image.GetHeight() > @logoSize@) {
  logo.scale = @logoSize@ / Math.Max(logo.image.GetWidth(), logo.image.GetHeight());
  logo.image = logo.image.Scale(Math.Max(1, Math.Int(logo.image.GetWidth() * logo.scale)), Math.Max(1, Math.Int(logo.image.GetHeight() * logo.scale)));
}
logo.sprite = Sprite(logo.image);
logo.sprite.SetOpacity(@logoOpacity@);
box.image = Image("box.png");
box.sprite = Sprite(box.image);
lock.image = Image("lock.png");
lock.sprite = Sprite(lock.image);
entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
title.sprite = Sprite();
prompt.sprite = Sprite();
bullet.image = Image("bullet.png");
max_bullets = 20;
for (i = 0; i < max_bullets; i++) {
  bullet.sprites[i] = Sprite(bullet.image);
  bullet.sprites[i].SetOpacity(0);
}
capslock.image = Image("capslock.png");
capslock.sprite = Sprite(capslock.image);
capslock.sprite.SetOpacity(0);
progress.track = Image("progress_track.png");
progress.track_sprite = Sprite(progress.track);
progress.fill = Image("progress_bar.png");
progress.fill_sprite = Sprite();
progress.track_sprite.SetOpacity(0);
progress.fill_sprite.SetOpacity(0);
message.sprite = Sprite();

# Keep long cryptsetup/device messages within their allocated region.
fun fit_image(img, width, height) {
  local.scale = 1;
  if (img.GetWidth() > width) scale = width / img.GetWidth();
  if (img.GetHeight() * scale > height) scale = height / img.GetHeight();
  if (scale < 1) img = img.Scale(Math.Max(1, Math.Int(img.GetWidth() * scale)), Math.Max(1, Math.Int(img.GetHeight() * scale)));
  return img;
}
fun fit_text(text, width, height, font) {
  return fit_image(Image.Text(text, @muted@, 1, font, "center"), width, height);
}
title.image = fit_image(Image.Text(@title@, @foreground@, 1, @titleFont@, "center"), 368, 40);
title.sprite.SetImage(title.image);

fun layout() {
  local.cx = Window.GetX() + Window.GetWidth() / 2;
  local.cy = Window.GetY() + Window.GetHeight() / 2;
  global.box.x = Math.Int(cx - box.image.GetWidth() / 2);
  global.box.y = Math.Int(cy - box.image.GetHeight() / 2);
  box.sprite.SetPosition(box.x, box.y, 10);
  lock.sprite.SetPosition(Math.Int(cx - lock.image.GetWidth() / 2), box.y + 32, 11);
  title.sprite.SetPosition(Math.Int(cx - title.image.GetWidth() / 2), Math.Int(box.y + 120 - title.image.GetHeight() / 2), 11);
  if (prompt.image)
    prompt.sprite.SetPosition(Math.Int(cx - prompt.image.GetWidth() / 2), Math.Int(box.y + 160 - prompt.image.GetHeight() / 2), 11);
  global.entry.x = Math.Int(cx - entry.image.GetWidth() / 2);
  global.entry.y = box.y + 200;
  entry.sprite.SetPosition(entry.x, entry.y, 11);
  # Material trailing icon: visible only while the password field is active.
  capslock.sprite.SetPosition(entry.x + entry.image.GetWidth() - capslock.image.GetWidth() - 16, Math.Int(entry.y + (entry.image.GetHeight() - capslock.image.GetHeight()) / 2), 12);
  capslock.sprite.SetOpacity(password_active && Plymouth.GetCapslockState());
  local.visible = Math.Min(bullet_count, max_bullets);
  for (i = 0; i < max_bullets; i++) {
    bullet.sprites[i].SetPosition(Math.Int(cx - (visible * 14 - 6) / 2 + i * 14), entry.y + 24, 12);
    bullet.sprites[i].SetOpacity(password_active && i < visible);
  }
  progress.track_sprite.SetPosition(Math.Int(cx - progress.track.GetWidth() / 2), Math.Int(cy + 64), 1);
  progress.fill_sprite.SetPosition(Math.Int(cx - progress.fill.GetWidth() / 2), Math.Int(cy + 64), 2);
  logo.sprite.SetPosition(Math.Int(cx - logo.image.GetWidth() / 2), Window.GetY() + Window.GetHeight() - logo.image.GetHeight() - @logoBottom@, 1);
  # Reserve room for feedback on short displays instead of overlapping the logo.
  if (logo.sprite.GetY() < box.y + box.image.GetHeight() + 72 && (password_active || message.sprite.GetOpacity() > 0))
    logo.sprite.SetOpacity(0);
  else
    logo.sprite.SetOpacity(@logoOpacity@);
  if (message.image)
    message.sprite.SetPosition(Math.Int(cx - message.image.GetWidth() / 2), box.y + box.image.GetHeight() + 20, 11);
}

fun dialog_opacity(opacity) {
  box.sprite.SetOpacity(opacity);
  lock.sprite.SetOpacity(opacity);
  title.sprite.SetOpacity(opacity);
  prompt.sprite.SetOpacity(opacity);
  entry.sprite.SetOpacity(opacity);
  capslock.sprite.SetOpacity(opacity && Plymouth.GetCapslockState());
  for (i = 0; i < max_bullets; i++)
    bullet.sprites[i].SetOpacity(opacity && i < bullet_count);
}

fun display_password_callback(text, bullets) {
  global.password_active = 1;
  global.bullet_count = bullets;
  if (!text) text = @passwordHint@;
  global.prompt.image = fit_text(text, 368, 40, @textFont@);
  prompt.sprite.SetImage(prompt.image);
  progress.track_sprite.SetOpacity(0);
  progress.fill_sprite.SetOpacity(0);
  dialog_opacity(1);
  layout();
}

fun display_normal_callback() {
  global.password_active = 0;
  global.bullet_count = 0;
  dialog_opacity(0);
}

fun progress_callback(duration, fraction) {
  # Password entry owns the center of the screen. Outside it, boot progress is
  # valid even when Plymouth never displayed a password dialog.
  if (password_active || fraction <= 0) {
    progress.track_sprite.SetOpacity(0);
    progress.fill_sprite.SetOpacity(0);
    return;
  }
  local.width = Math.Max(1, Math.Int(progress.fill.GetWidth() * Math.Min(1, fraction)));
  progress.fill_sprite.SetImage(progress.fill.Scale(width, progress.fill.GetHeight()));
  progress.track_sprite.SetOpacity(1);
  progress.fill_sprite.SetOpacity(1);
  layout();
}

fun display_message_callback(text) {
  global.message.image = fit_text(text, Math.Min(480, Window.GetWidth() - 48), 40, @textFont@);
  message.sprite.SetImage(message.image);
  message.sprite.SetOpacity(1);
  layout();
}
fun hide_message_callback(text) { message.sprite.SetOpacity(0); }

dialog_opacity(0);
layout();
Plymouth.SetRefreshFunction(layout);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetBootProgressFunction(progress_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
